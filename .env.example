# Gmail: use a Google App Password, never your normal account password.
GMAIL_USERNAME=your-address@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
REPORT_RECIPIENTS=your-address@gmail.com

# Public GitHub Pages URL. When set, email detail links open the interactive report.
REPORT_PUBLIC_URL=https://your-account.github.io/your-repository

# Korean translation and detail summaries. Without it the report falls back to
# Google translation and RSS excerpts, and the run records that downgrade.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Override where the harness keeps its durable state.
AI_NEWS_DB=data/ai_news.db

# Comma-separated RSS feeds can be added without code changes.
EXTRA_FEEDS=
